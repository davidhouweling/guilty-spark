---
export const prerender = false;

import { API_HOST } from "../../../constants";
import Layout from "../../../layouts/layout.astro";
import { PlayerStatsApp } from "../../../apps/player-stats/create";
import ErrorState from "../../../components/error-state/error-state.astro";
import { playerStatsContract } from "@guilty-spark/shared/contracts/stats/player";
import type { PlayerStatsResponse } from "@guilty-spark/shared/contracts/stats/player";

const { gamertag = "" } = Astro.params;
let lookupStatus = 500;
let initialResponse: PlayerStatsResponse | undefined;

if (gamertag !== "") {
  try {
    const url = new URL(`/api/stats/player/${encodeURIComponent(gamertag)}`, String(API_HOST));
    for (const parameter of ["guildId", "queueChannelId", "window", "minGamesPlayed"]) {
      const value = Astro.url.searchParams.get(parameter);
      if (value != null && value !== "") {
        url.searchParams.set(parameter, value);
      }
    }

    const response = await fetch(url);
    lookupStatus = response.status;
    if (response.ok) {
      initialResponse = await playerStatsContract.fromResponse(response.clone());
    }
    Astro.response.status = lookupStatus;
    if (lookupStatus >= 500) {
      Astro.response.headers.set("Cache-Control", "no-store");
    }
  } catch {
    Astro.response.status = 500;
    Astro.response.headers.set("Cache-Control", "no-store");
  }
} else {
  Astro.response.status = 404;
  lookupStatus = 404;
}
---

<Layout title="Player Stats - Guilty Spark" description="Public Halo Infinite player statistics">
  {
    lookupStatus === 200 ? (
      <PlayerStatsApp client:only="react" apiHost={API_HOST} gamertag={gamertag} initialResponse={initialResponse} />
    ) : (
      <ErrorState
        title={lookupStatus === 404 ? "Player stats not found" : "Unable to load player stats"}
        message={
          lookupStatus === 404
            ? "No leaderboard data was found for this player."
            : "The player stats could not be loaded right now."
        }
      />
    )
  }
</Layout>
