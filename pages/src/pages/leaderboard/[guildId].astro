---
export const prerender = false;

import { API_HOST } from "../../constants";
import Layout from "../../layouts/layout.astro";
import { LeaderboardApp } from "../../apps/leaderboard/create";
import ErrorState from "../../components/error-state/error-state.astro";

const { guildId = "" } = Astro.params;
const isValidGuildId = /^\d+$/.test(guildId);
let lookupStatus = isValidGuildId ? 500 : 404;

if (isValidGuildId) {
  try {
    const url = new URL("/api/leaderboard", String(API_HOST));
    url.searchParams.set("guildId", guildId);
    url.searchParams.set("pageSize", "1");
    const response = await fetch(url);
    lookupStatus = response.status;
    Astro.response.status = lookupStatus;
    if (lookupStatus >= 500) {
      Astro.response.headers.set("Cache-Control", "no-store");
    }
  } catch {
    Astro.response.status = 500;
    Astro.response.headers.set("Cache-Control", "no-store");
  }
} else {
  Astro.response.status = 404;
}
---

<Layout title="Leaderboard - Guilty Spark" description="Public Halo Infinite leaderboard">
  {
    lookupStatus === 200 ? (
      <LeaderboardApp client:only="react" apiHost={API_HOST} guildId={guildId} queueChannelId={null} />
    ) : (
      <ErrorState
        title={lookupStatus === 404 ? "Leaderboard not found" : "Unable to load leaderboard"}
        message={
          lookupStatus === 404
            ? "No completed leaderboard data was found for this guild."
            : "The leaderboard could not be validated right now."
        }
      />
    )
  }
</Layout>
